<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_top_bg"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vágólap műveletek"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/onSurface"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnCopyToClipboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Másolás vissza a vágólapra"
        style="@style/RoundedButton"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnDeleteEntry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Törlés"
        style="@style/RoundedButton"
        android:backgroundTint="@color/tertiary"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnExportJSON"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Exportálás JSON fájlba"
        style="@style/RoundedButton"
        android:backgroundTint="@color/secondary" />

</LinearLayout>
